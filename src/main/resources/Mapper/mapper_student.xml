<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.mybatis.example.student">
    <select id="get_stu_by_id" resultType="org.example.student">
        select
            s.*,
            t.tname
        from
            student s,
            teacher t
        where
            s.id = #{id} AND
            s.tid = t.tid
    </select>
</mapper>